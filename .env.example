# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
#
# These are ALPACA **PAPER** credentials. Generate them at:
#   https://app.alpaca.markets/  ->  Paper Trading  ->  API Keys
# Paper keys are distinct from live keys (Alpaca docs, "Paper Trading").
# This project refuses to start if the base URL is not the paper endpoint.
# ---------------------------------------------------------------------------

ALPACA_API_KEY_ID=your_paper_key_id_here
ALPACA_API_SECRET_KEY=your_paper_secret_here

# Must remain the paper endpoint. src/config.py hard-fails on anything else.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Explicit belt-and-braces switch. Must be "true".
PAPER_TRADING_ONLY=true

# Optional, free tier, only if a specific dataset needs it.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
